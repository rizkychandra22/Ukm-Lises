root = true

[*]
charset = utf-8
end_of_line = lf
indent_size = 4
indent_style = space
insert_final_newline = true
trim_trailing_whitespace = true

[*.md]
trim_trailing_whitespace = false

[*.{yml,yaml}]
indent_size = 2

[{compose,docker-compose}.{yml,yaml}]
indent_size = 4

# Standar PHP (Backend)
[*.php]
indent_style = space
indent_size = 4

# Standar Frontend (React/TS/JS)
[*.{js,jsx,ts,tsx,json,css}]
indent_style = space
indent_size = 2

# Standar Blade (Laravel Frontend)
[*.blade.php]
indent_style = space
indent_size = 4
